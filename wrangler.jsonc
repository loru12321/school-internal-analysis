{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "school-internal-analysis",
  "main": "worker/index.js",
  "compatibility_date": "2026-04-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school-internal-analysis-db",
      "database_id": "6e3da1ca-24c5-44d6-bb75-dda0cede267a"
    }
  ]
}
